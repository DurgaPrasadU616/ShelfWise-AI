# Frontend environment
# Base URL of the backend API. In production (Vercel), set this to your Render URL, e.g.
# VITE_API_URL=https://shelfwise-ai-api.onrender.com/api
# If left empty, the client calls the same origin (/api) — which pairs with the dev
# Vite proxy or a reverse-proxy setup on the host.
VITE_API_URL=