# Server environment
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/shelfwise
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_CONNECT_RETRIES=5
MONGO_RETRY_DELAY_MS=2000

# CORS
CORS_ORIGIN=http://localhost:5173

# JWT
# REQUIRED: There are no default fallbacks for these secrets.
# In production, the server will crash if these are missing.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Logger
LOG_LEVEL=info
LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/app.log

# AI (Gemini)
GEMINI_API_KEY=your-gemini-api-key

# Email (SMTP) — leave blank in dev to use Ethereal preview emails
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=ShelfWise AI <noreply@shelfwise.ai>

# WhatsApp / SMS (future — uncomment when ready)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# WHATSAPP_FROM_NUMBER=whatsapp:+14155238886
